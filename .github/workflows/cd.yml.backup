name: CD

on:
  push:
    tags:
      - 'v*'            # dispara em tag tipo v1.0.0
  workflow_dispatch:    # permite trigger manual na UI

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ secrets.DOCKERHUB_USERNAME }}/fiap-ml-cicd
          tags: |
            type=ref,event=tag
            type=raw,value=latest

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            APP_VERSION=${{ github.ref_name }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  smoke-test:
    runs-on: ubuntu-latest
    needs: build-and-push
    steps:
      - name: Sobe a imagem publicada
        run: |
          IMAGE=${{ secrets.DOCKERHUB_USERNAME }}/fiap-ml-cicd:latest
          docker pull "$IMAGE"
          docker run -d --name smoke -p 5001:5001 "$IMAGE"

      - name: Espera readiness
        run: |
          for i in $(seq 1 15); do
            if curl -sf localhost:5001/ready; then echo " -> ready"; exit 0; fi
            sleep 2
          done
          echo "❌ container nao ficou ready"
          docker logs smoke
          exit 1

      - name: Testa /predict
        run: |
          OUT=$(curl -sf -X POST localhost:5001/predict \
            -H 'Content-Type: application/json' \
            -d '{"features":[5.1,3.5,1.4,0.2]}')
          echo "Resposta: $OUT"
          echo "$OUT" | grep -q '"label"' || { echo "❌ smoke test falhou"; exit 1; }
          echo "✅ Smoke test OK"

      - name: Limpa
        if: always()
        run: docker rm -f smoke || true

  # ------------------------------------------------------------------
  # DEPLOY no Kubernetes (referencia)
  # ------------------------------------------------------------------
  # Um runner do GitHub NAO alcanca o cluster local do Docker Desktop.
  # Em producao (cluster acessivel / self-hosted runner) o deploy seria:
  #
  #   deploy:
  #     runs-on: ubuntu-latest
  #     needs: smoke-test
  #     steps:
  #       - uses: azure/setup-kubectl@v4
  #       - run: |   # KUBECONFIG vem de secret
  #           kubectl set image deployment/iris-api \
  #             iris-api=${{ secrets.DOCKERHUB_USERNAME }}/fiap-ml-cicd:${{ github.ref_name }}
  #           kubectl rollout status deployment/iris-api --timeout=120s
  #
  # No hands-on (Docker Desktop) esse passo roda LOCALMENTE — veja
  # docs/HANDS-ON-08-03.md, Parte "Deploy da nova versao".
